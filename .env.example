# Copy this file to .env and fill in real values. Never commit .env.
#
# .env is loaded by docker-compose (via `env_file`) and by each service's
# config loader when running locally outside Docker. Names here match the
# `*_env` keys referenced in config.yaml — config.yaml never holds secrets
# itself, only the *names* of the environment variables that hold them.

# Anthropic API key used by the backend/orchestrator for the main chat model
# and by the guardrails classifier. Without this set, the backend falls back
# to a mocked-response mode (clearly logged) instead of calling a real model.
ANTHROPIC_API_KEY=

# Path to the SQLite database file, shared via a Docker volume between
# db-init and the api service. Override if you relocate the volume mount.
DATABASE_PATH=/data/bookly.db

# Log level for all services (DEBUG, INFO, WARNING, ERROR). Overrides the
# `logging.level` default in config.yaml when set.
LOG_LEVEL=INFO
